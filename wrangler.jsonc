// Cloudflare Workers 配置(经 Git 集成由 Workers Builds 云端执行,本地无需 CLI)
{
  "name": "3d-std",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // T3-r2:SPA 回退模式会把「导航请求」(地址栏直接访问)接走返回 index.html;
    // /api/* 必须无条件先进 Worker,否则浏览器直开 /api/health 看到的是应用页面而非 JSON。
    "run_worker_first": ["/api/*"]
  },
  // T3:配额账务 Durable Object(SQLite 存储后端,免费档可用;强一致,KV 不参与账务/熔断)
  "durable_objects": {
    "bindings": [{ "name": "QUOTA_DO", "class_name": "QuotaDO" }]
  },
  "migrations": [{ "tag": "t3-quota", "new_sqlite_classes": ["QuotaDO"] }],
  // 可在 dashboard 覆盖的运行参数(Secrets 另设:TURNSTILE_SECRET_KEY、DEMO_CODES、TRIPO_API_KEY)。
  // 注意:Git 集成部署会以本文件覆盖 dashboard 改过的 vars(Secrets 不受影响)——
  // 所以引擎切换以改此文件为准,dashboard 改 var 活不过下一次 push。
  "vars": {
    "VISITOR_DAILY_LIMIT": "3",
    "DEMO_DEFAULT_LIMIT": "20",
    "BREAKER_DAILY_CREDITS": "3000",
    // T13a:真实引擎上线('tripo')。回退演示/降级通道:改回 "mock" 后 push(@mock 指令随之可用);
    // 置空即回到「未接入 → 扣减立返」的 T3 行为。成本护栏:访客配额 3 次/日 + 全局熔断 3000 credits/日。
    "ENGINE_MODE": "hi3d",
    // M1.13a: Hi3D 图生3D。AK/SK 必须使用 Workers Secrets，禁止写入 vars/Git。
    "HI3D_MODEL": "hitem3dv2.1",
    "HI3D_RESOLUTION": "1536fast",
    "HI3D_FACE_COUNT": "500000",
    "HI3D_TIMEOUT_MS": "900000",
    // Hi3D 真实语义拆件：默认每访客 2 次/日，按官方单次 20 credits 记账。
    "HI3D_SPLIT_DAILY_LIMIT": "2",
    "HI3D_SPLIT_BREAKER_CREDITS": "200",
    "HI3D_SPLIT_COST_CREDITS": "20",
    // T13a:文生模型版本(v2.5-20250123 = 20 credits 档,与 api-types 的 CREDITS_BY_TYPE 对齐;
    // 升 v3.x 时须同步核对计费常量,consumed_credit 对账日志会暴露价差)
    "TRIPO_MODEL_VERSION": "v2.5-20250123",
    // T13a:排队+生成超时合成阈值(超过即按 AI-05 timeout 类失败并返还)
    "TRIPO_TIMEOUT_MS": "600000",
    // M1.6.2.1:只读拆件分析。AIHUBMIX_API_KEY 必须作为 Worker Secret 配置，禁止写入本文件。
    // Provider 仅接受 openai/aihubmix 固定白名单；切回 openai 时继续使用已保留的 OPENAI_API_KEY Secret。
    "SPLIT_ANALYSIS_PROVIDER": "aihubmix",
    "SPLIT_ANALYSIS_MODEL": "gpt-5.6-sol",
    "SPLIT_ANALYSIS_REASONING_EFFORT": "low",
    // M1.6.3:AIHubMix 在四视角结构化输出下的实测可能超过 45 秒；服务端留到 75 秒，
    // 浏览器等待 85 秒，仍低于路由代码的 90 秒硬上限。延迟优化继续由 Gold Set 评测跟踪。
    "SPLIT_ANALYSIS_TIMEOUT_MS": "75000",
    "SPLIT_ANALYSIS_MAX_OUTPUT_TOKENS": "3200",
    "SPLIT_ANALYSIS_DAILY_LIMIT": "3",
    "SPLIT_ANALYSIS_BREAKER_UNITS": "100",
    "SPLIT_ANALYSIS_COST_UNITS": "1",
    // M1.16b:DeepSeek V4 Flash 负责低延迟自然对话；服务端使用 Chat Completions + JSON 校验。
    // Secret 仍只存在 Worker；对话不会自动调用生图或 Hi3D。
    "CREATION_AGENT_PROVIDER": "aihubmix",
    "CREATION_AGENT_MODEL": "deepseek-v4-flash",
    "CREATION_AGENT_PROTOCOL": "chat_completions",
    "CREATION_AGENT_REASONING_EFFORT": "low",
    "CREATION_AGENT_TIMEOUT_MS": "60000",
    "CREATION_AGENT_MAX_OUTPUT_TOKENS": "2400",
    "CREATION_AGENT_DAILY_LIMIT": "20",
    "CREATION_AGENT_BREAKER_UNITS": "500",
    "CREATION_AGENT_COST_UNITS": "1",
    // 视觉方案继续使用已验证的 strict-schema 模型，避免对话模型协议影响后续链路。
    "CREATION_CONCEPT_MODEL": "gpt-5.6-sol",
    "CREATION_CONCEPT_REASONING_EFFORT": "low",
    "CREATION_CONCEPT_TIMEOUT_MS": "60000",
    "CREATION_CONCEPT_MAX_OUTPUT_TOKENS": "3500",
    "CREATION_CONCEPT_DAILY_LIMIT": "5",
    "CREATION_CONCEPT_BREAKER_UNITS": "300",
    "CREATION_CONCEPT_COST_UNITS": "2",
    // M1.15a:参考图先由 VLM 只读提取视觉证据；图片不落库，失败返还独立额度。
    "CREATION_REFERENCE_MODEL": "gemini-2.5-flash",
    "CREATION_REFERENCE_TIMEOUT_MS": "60000",
    "CREATION_REFERENCE_MAX_OUTPUT_TOKENS": "3000",
    "CREATION_REFERENCE_DAILY_LIMIT": "8",
    "CREATION_REFERENCE_BREAKER_UNITS": "300",
    "CREATION_REFERENCE_COST_UNITS": "2",
    // M1.15a:确认视觉方向后才调用付费生图；低质量预览用于控制首版成本。
    "CREATION_IMAGE_MODEL": "gpt-image-2",
    "CREATION_IMAGE_TIMEOUT_MS": "120000",
    "CREATION_IMAGE_SIZE": "1024x1024",
    "CREATION_IMAGE_QUALITY": "low",
    "CREATION_IMAGE_DAILY_LIMIT": "3",
    "CREATION_IMAGE_BREAKER_UNITS": "100",
    "CREATION_IMAGE_COST_UNITS": "10",
    // mock 参数保留:ENGINE_MODE 切回 "mock" 时生效
    "MOCK_QUEUE_MS": "4000",
    "MOCK_RUN_MS": "10000",
    // 随机失败率 0–1(演示混沌注入用;prompt 内 @mock:fail= 指令优先于此)
    "MOCK_FAIL_RATE": "0"
  }
  // T13b(演示范围外,backlog v1.1):R2(生成结果转存)、清理 Cron —— 恢复时在此追加 binding。
  // 任务映射已随 T13a 落入 QuotaDO(mapPut/mapGet),KV 不再需要(论证见 worker/tripo-engine.ts)。
}
