{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "message", "brief", "questions", "nextAction", "readiness", "assumptions"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["creation-agent-output.v1"] },
    "message": { "type": "string" },
    "brief": { "$ref": "#/$defs/brief" },
    "questions": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/question" }
    },
    "nextAction": {
      "type": "string",
      "enum": ["ask_questions", "review_brief", "request_reference", "ready_for_concept"]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "missingFields"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingFields": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "assumptions": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "partCount": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["minimum", "preferred", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1, "maximum": 100 },
        "preferred": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "projectType", "purpose", "style", "targetHeightMm", "pose", "preferredPartCount", "notes"],
      "properties": {
        "subject": { "$ref": "#/$defs/nullableString" },
        "projectType": { "type": "string", "enum": ["character", "mecha", "prop", "product", "scene", "other", "unknown"] },
        "purpose": { "type": "string", "enum": ["resin_print", "fdm_print", "display", "prototype", "unknown"] },
        "style": { "$ref": "#/$defs/nullableString" },
        "targetHeightMm": { "type": ["number", "null"], "minimum": 1, "maximum": 5000 },
        "pose": { "$ref": "#/$defs/nullableString" },
        "preferredPartCount": { "$ref": "#/$defs/partCount" },
        "notes": { "type": "array", "maxItems": 20, "items": { "type": "string" } }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "description", "recommended"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "recommended": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "targetField", "question", "options", "allowFreeText"],
      "properties": {
        "questionId": { "type": "string" },
        "targetField": {
          "type": "string",
          "enum": ["subject", "project_type", "purpose", "style", "target_height", "pose", "preferred_part_count", "notes"]
        },
        "question": { "type": "string" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } },
        "allowFreeText": { "type": "boolean", "enum": [true] }
      }
    }
  }
}
