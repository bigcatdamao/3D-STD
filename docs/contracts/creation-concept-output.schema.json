{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "summary", "schemes", "recommendedSchemeId", "recommendationReason", "nextAction"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["creation-concept-output.v1"] },
    "summary": { "type": "string" },
    "schemes": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/scheme" } },
    "recommendedSchemeId": { "type": "string" },
    "recommendationReason": { "type": "string" },
    "nextAction": { "type": "string", "enum": ["select_scheme"] }
  },
  "$defs": {
    "shortList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefFit", "distinctiveness", "printability"],
      "properties": {
        "briefFit": { "type": "integer", "minimum": 0, "maximum": 100 },
        "distinctiveness": { "type": "integer", "minimum": 0, "maximum": 100 },
        "printability": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemeId", "title", "tagline", "description", "visualKeywords", "silhouetteStrategy", "colorMaterialStrategy", "poseComposition", "printableStrategy", "strengths", "tradeoffs", "scores", "imagePrompt", "negativePrompt"],
      "properties": {
        "schemeId": { "type": "string" },
        "title": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "visualKeywords": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string" } },
        "silhouetteStrategy": { "type": "string" },
        "colorMaterialStrategy": { "type": "string" },
        "poseComposition": { "type": "string" },
        "printableStrategy": { "type": "string" },
        "strengths": { "$ref": "#/$defs/shortList" },
        "tradeoffs": { "$ref": "#/$defs/shortList" },
        "scores": { "$ref": "#/$defs/scores" },
        "imagePrompt": { "type": "string" },
        "negativePrompt": { "type": "string" }
      }
    }
  }
}
